# Copy to .env and fill in. Never commit .env.
# Database name is taken from the URI path (…mongodb.net/<db-name>). MONGODB_DB overrides it if set.
MONGODB_URI=
MONGODB_DB=
DASHBOARD_PASSWORD=
SESSION_SECRET=

# GoHighLevel chat widget id (GHL > Sites > Chat Widget > Get Code). Leave empty to hide the chat.
NEXT_PUBLIC_GHL_WIDGET_ID=
